# Copy to .env.local, or run `vercel env pull .env.local` to fill these from the Vercel project.
# Never commit real values.

# Neon Postgres (added via Vercel Marketplace). Pooled connection string.
POSTGRES_URL=

# Vercel Blob store read/write token.
BLOB_READ_WRITE_TOKEN=

# Anthropic API key for the photo check (console.anthropic.com).
ANTHROPIC_API_KEY=

# Shared secret for GET /api/missing-today (n8n 11:00 reminder). Long random string,
# e.g. `openssl rand -base64 32`. Unset = endpoint returns 503.
REMINDER_SECRET=
